{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "extensions/**/*.ts",
    "extensions/hello-status.ts.disabled",
    "extensions/footer-status.ts.disabled"
  ]
}
